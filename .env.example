# The demo needs no secrets and makes no network calls.
# These variables document where real integrations will plug in later.
# They are NOT read by the mock repository layer today.

# Switch the service layer from the in-browser mock to a real HTTP backend (not implemented).
NEXT_PUBLIC_DATA_SOURCE=mock

# FastAPI backend base URL (future).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid

# OIDC provider (future).
# NEXT_PUBLIC_OIDC_ISSUER=
# NEXT_PUBLIC_OIDC_CLIENT_ID=

# Sensor / gateway API (future, supplier TBC).
# SENSOR_GATEWAY_API_URL=
