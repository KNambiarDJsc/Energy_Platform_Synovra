{
  "name": "synovra-battery-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Synovra Battery Intelligence Platform - demo with synthetic data and a mock repository layer",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:server": "vitest run server/tests",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "tsup server/src/index.ts server/src/cli.ts --format esm --platform node --target node20 --out-dir server/dist --clean",
    "server:start": "node server/dist/index.mjs",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:migrate": "tsx server/src/cli.ts migrate",
    "db:seed": "tsx server/src/cli.ts seed-demo",
    "db:bootstrap": "tsx server/src/cli.ts bootstrap",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.13",
    "@hono/node-server": "1.14.4",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-tabs": "1.1.1",
    "@tanstack/react-query": "5.59.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.36.4",
    "hono": "4.6.9",
    "jose": "5.9.6",
    "lucide-react": "0.451.0",
    "next": "14.2.35",
    "pg": "8.13.1",
    "qrcode.react": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.48.0",
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
